# pySED input file - SrTiO3 example
# Edit the paths, structure, and MD settings to match your own simulation.
# Start with compute; use plot or fit after SED data have been generated.
# Online manual: https://pysed.readthedocs.io/

# ==================== Control ====================
action = compute  # compute | plot | fit | thinking (automatic workflow)
device = cpu      # cpu | gpu (CuPy); plotting and fitting use the CPU

# ==================== MD simulation ====================
num_atoms          = 40000   # Number of atoms in the trajectory
total_num_steps    = 300000  # Production MD steps, not saved frames
time_step          = 1       # MD integration time step in fs
output_data_stride = 15      # MD steps between saved trajectory frames

# ==================== Input / output ====================
# Input paths are relative to this file; outputs go to the working directory.
trajectory_file          = ../gpumd_run/dump.xyz       # Positions and velocities
basis_lattice_file       = ../structure/basis.in       # Atom-to-unit-cell mapping
out_files_name           = SrTiO3                      # Prefix for SED output files
trajectory_read_mode     = cache                       # cache | direct for text trajectories
trajectory_prefetch      = 1                           # Prepare the next block in the background
netcdf_compression_level = 1                           # Text-cache compression: 0 off, 1-9 enabled

# ==================== Structure ====================
supercell_dim = 20 20 20  # Repeats along the three unit-cell vectors
prim_unitcell = 3.89598 0 0  0 3.89598 0  0 0 3.89598  # Lattice vectors in angstrom
rescale_prim  = 1         # Reconstruct the primitive cell from the MD cell

# ==================== Q-points ====================
num_qpaths  = 5       # Number of consecutive path segments
q_path_name = GXMGRM  # Endpoint labels; G denotes Gamma
# One fractional reciprocal-coordinate triple per endpoint (num_qpaths + 1).
q_path      = 0.0 0.0 0.0  0.0 0.5 0.0  0.5 0.5 0.0  0.0 0.0 0.0  0.5 0.5 0.5  0.5 0.5 0.0

# ==================== Computation ====================
num_blocks     = 5  # Equal time blocks; average their SED spectra
max_cores      = 8  # Maximum CPU worker processes; unused on GPU
output_partial = 1  # Also save element/direction-resolved SED
# Saved frames (total_num_steps / output_data_stride) must divide into full blocks.

# ==================== SED plot ====================
# plot_partial_SED = Sr y  # Sr y component; requires output_partial = 1 at compute
plot_cutoff_freq   = 25.0  # Upper frequency shown in SED maps, THz
plot_interval      = 5.0   # Frequency-axis tick spacing, THz
qpoint_slice_index = 23    # Zero-based q-point index for single-q plots/fits
plot_slice         = 1     # Also plot the selected single-q spectrum
if_show_figures    = 0     # 0: save figures only; 1: also display them
# colorbar_min     = -20   # Optional lower natural-log SED color limit
# colorbar_max     = -2    # Optional upper natural-log SED color limit

# ==================== Spectral fitting ====================
lorentz_fit_all_qpoint        = 0     # 0: selected q-point; 1: all q-points
lorentz_fit_freq_min          = 0     # Lower peak-detection/fitting bound, THz
lorentz_fit_freq_max          = 25    # Upper fit bound and fit-figure limit, THz
peak_min_significance         = 5.0   # Higher values reject more weak/noisy peaks
fitting_function              = auto  # auto | lorentz | dho
initial_guess_hwhm            = 0.01  # Initial peak HWHM for Lorentz/DHO, THz
re_output_total_freq_lifetime = 1     # Rebuild the combined table after a single-q fit
