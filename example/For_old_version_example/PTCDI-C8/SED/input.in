# pySED 3.0 migration of the historical PTCDI-C8 example
action = compute
method = sed
backend = numpy

trajectory_file = ../lammps_run/trajectory.dump
trajectory_read_mode = cache
trajectory_prefetch = 1
netcdf_batch_size = 64
netcdf_compression_level = 1
lammps_unit = metal
out_files_name = PTCDI-C8-300K

num_atoms = 42240
total_num_steps = 1048576
time_step = 0.5
output_data_stride = 32
num_blocks = 2
max_cores = 4

basis_lattice_file = ../structure/basis.in
prim_unitcell = 20.751 0 0  0 8.4397 0  0 0 4.8423
supercell_dim = 30 4 4
rescale_prim = 1

num_qpaths = 1
q_path_name = GX
q_path = 0 0 0  1/2 0 0

plot_cutoff_freq = 2
plot_interval = 0.5
plot_slice = 1
qpoint_slice_index = 2
if_show_figures = 0

lorentz_fit_all_qpoint = 0
fitting_function = auto
peak_min_significance = 4.0
peak_max_hwhm = 3.0
