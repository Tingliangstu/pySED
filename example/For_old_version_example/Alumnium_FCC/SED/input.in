# pySED 3.0 migration of the historical Aluminum FCC example
action = compute
backend = numpy

trajectory_file = ../lammps_run/trajectory.dump
trajectory_read_mode = cache
trajectory_prefetch = 1
netcdf_batch_size = 64
netcdf_compression_level = 1
lammps_unit = metal
out_files_name = Alumnium_FCC

num_atoms = 480
total_num_steps = 2097152
time_step = 0.75
output_data_stride = 32
num_blocks = 64
max_cores = 4

basis_lattice_file = ../structure/basis.in
prim_unitcell = 4.05 0 0  0 4.05 0  0 0 4.05
supercell_dim = 30 2 2
rescale_prim = 1

num_qpaths = 1
q_path_name = GX
q_path = 0 0 0  1/2 0 0

plot_interval = 5
plot_slice = 1
qpoint_slice_index = 2
if_show_figures = 0

lorentz_fit_all_qpoint = 0
fitting_function = auto
peak_min_significance = 4.0
peak_max_hwhm = 3.0
modulate_factor = 10
