# pySED 3.0: primitive-cell silicon, GPUMD extended-XYZ trajectory
action = compute
method = sed
backend = numpy

trajectory_file = ../gpumd_run/dump.xyz
trajectory_read_mode = cache
trajectory_prefetch = 1
netcdf_batch_size = 64
netcdf_compression_level = 1
out_files_name = silicon

num_atoms = 16000
total_num_steps = 100000
time_step = 1
output_data_stride = 20
num_blocks = 5
max_cores = 4

basis_lattice_file = ../structure/basis.in
prim_unitcell = 3.86697 0 0  1.93349 3.3489 0  1.93349 1.1163 3.15737
supercell_dim = 20 20 20
rescale_prim = 1

num_qpaths = 5
q_path_name = GXUKGL
q_path = 0 0 0  1/2 0 1/2  5/8 1/4 5/8  3/8 3/8 3/4  0 0 0  1/2 1/2 1/2

plot_cutoff_freq = 20
plot_interval = 5
plot_slice = 0
qpoint_slice_index = 2
if_show_figures = 0

lorentz_fit_all_qpoint = 0
lorentz_fit_freq_max = 20
fitting_function = auto
peak_min_significance = 4.0
initial_guess_hwhm = 0.001
