# pySED 3.0 notebook companion: bulk MoS2
action = compute
device = cpu

trajectory_file = dump.xyz
trajectory_read_mode = cache
trajectory_prefetch = 1
netcdf_batch_size = 64
netcdf_compression_level = 1
out_files_name = bulk_MoS2

num_atoms = 13824
total_num_steps = 500000
time_step = 1
output_data_stride = 50
num_blocks = 5
max_cores = 4

basis_lattice_file = basis.in
prim_unitcell = 3.11905 0 0  -1.55952 2.70117 0  0 0 12.6227
supercell_dim = 12 12 16
rescale_prim = 1

num_qpaths = 1
q_path_name = GA
q_path = 0 0 0  0 0 1/2

plot_cutoff_freq = 2
plot_interval = 0.5
plot_slice = 1
qpoint_slice_index = 0
if_show_figures = 0

lorentz_fit_all_qpoint = 0
lorentz_fit_freq_max = 2
fitting_function = auto
peak_min_significance = 4.0
initial_guess_hwhm = 0.001
