# Deterministic cache-mode calculation
action = compute
method = sed
backend = numpy

trajectory_file = trajectory.dump
trajectory_read_mode = cache
trajectory_prefetch = 1
netcdf_batch_size = 32
netcdf_compression_level = 1
lammps_unit = metal
out_files_name = synthetic

num_atoms = 8
total_num_steps = 2560
time_step = 1
output_data_stride = 10
num_blocks = 4
max_cores = 1

basis_lattice_file = basis.in
prim_unitcell = 1 0 0  0 1 0  0 0 1
supercell_dim = 2 2 2
rescale_prim = 0

num_qpaths = 1
q_path_name = GX
q_path = 0 0 0  1/2 0 0

plot_cutoff_freq = 15
plot_interval = 2.5
plot_slice = 1
qpoint_slice_index = 1
if_show_figures = 0

lorentz_fit_all_qpoint = 0
lorentz_fit_freq_min = 3
lorentz_fit_freq_max = 10
fitting_function = auto
peak_min_significance = 3.0
initial_guess_hwhm = 0.5
