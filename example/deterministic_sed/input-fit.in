# Fit the known X-point peak after input.in has been computed
action = fit
method = sed
out_files_name = synthetic
qpoint_slice_index = 1
lorentz_fit_all_qpoint = 0
lorentz_fit_freq_min = 3
lorentz_fit_freq_max = 10
fitting_function = auto
peak_min_significance = 3.0
initial_guess_hwhm = 0.5
if_show_figures = 0
