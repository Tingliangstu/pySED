# pySED 3.0: carbon nanotube, GPUMD extended-XYZ trajectory
action = compute
device = cpu

trajectory_file = ../gpumd_run/dump.xyz
trajectory_read_mode = cache
trajectory_prefetch = 1
netcdf_batch_size = 64
netcdf_compression_level = 1
out_files_name = CNT

num_atoms = 17920
total_num_steps = 500000
time_step = 1
output_data_stride = 8
num_blocks = 5
max_cores = 36

basis_lattice_file = ../structure/basis.in
prim_unitcell = 237.4331970215 0 0  0 237.4331970215 0  0 0 2.463436
supercell_dim = 1 1 160
rescale_prim = 1

num_qpaths = 1
q_path_name = GA
q_path = 0 0 0  0 0 1/2

plot_cutoff_freq = 50
plot_interval = 10
plot_slice = 1
qpoint_slice_index = 0
if_show_figures = 0

lorentz_fit_all_qpoint = 1
lorentz_fit_freq_max = 5
fitting_function = auto
peak_min_significance = 4.0
initial_guess_hwhm = 0.005
re_output_total_freq_lifetime = 0
