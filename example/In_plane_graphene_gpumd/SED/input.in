# pySED 3.0: in-plane graphene, GPUMD extended-XYZ trajectory
action = compute
backend = numpy

trajectory_file = ../gpumd_run/dump.xyz
trajectory_read_mode = cache
trajectory_prefetch = 1
netcdf_batch_size = 64
netcdf_compression_level = 1
out_files_name = graphene_all

num_atoms = 3200
total_num_steps = 500000
time_step = 1
output_data_stride = 10
num_blocks = 5
max_cores = 4

basis_lattice_file = ../structure/basis.in
prim_unitcell = 2.46627 0 0  -1.2331 2.1359 0  0 0 50
supercell_dim = 40 40 1
rescale_prim = 1

num_qpaths = 3
q_path_name = GMKG
q_path = 0 0 0  1/2 0 0  1/3 1/3 0  0 0 0

plot_cutoff_freq = 50
plot_interval = 10
plot_slice = 0
qpoint_slice_index = 0
use_contourf = 1
if_show_figures = 0

lorentz_fit_all_qpoint = 0
fitting_function = auto
peak_min_significance = 4.0
initial_guess_hwhm = 0.01
